# --- API -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- RavenDB ---------------------------------------------------------------
# Comma-separated list of RavenDB node URLs.
RAVENDB_URLS=http://localhost:8080
RAVENDB_DATABASE=ccscammers-bets
# Create the database on boot if it does not exist yet (development convenience).
RAVENDB_ENSURE_DATABASE=true
# Client certificate, required for a secured cluster. Leave blank for local HTTP.
RAVENDB_CERT_PATH=
RAVENDB_CERT_PASSPHRASE=

# --- Web -------------------------------------------------------------------
# Base URL the browser uses to reach the API.
VITE_API_URL=http://localhost:3000
